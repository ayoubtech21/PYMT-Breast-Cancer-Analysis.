        "# Phase 2: the effect of 10mMpp treatment on PYMT disease 🧬\n",
        "\n",
        "## 1. this is the analysis effect of 10mMpp treatment on the sample 1 affected\n",
        "import pandas as pd\n",
        "\n",
        "# Load the compressed RNA-Seq count data\n",
        "df = pd.read_csv('GSE344396_Rai_et_al_rawcounts_allsamples.csv.gz', compression='gzip')\n",
        "\n",
        "# Define columns for comparison (Replicate 1: Baseline vs. Day 7)\n",
        "day0 =  'QGJ65Q_25_PYMT_LNP_10mMpp_Day0_Rep_1_Counts'\n",
        "\n",
        "day7 =   'QGJ65Q_29_PYMT_LNP_10mMpp_Day7_Rep_1_Counts'\n",
        "\n",
        "\n",
        "\n",
        "# 1. We calculate the difference between the first day and the seven day\n",
        "\n",
        "df['Difference'] = df[day7] - df[day0]\n",
        "\n",
        "# 2 . we sort the table from largest to smallest\n",
        "\n",
        "df_sorted = df.sort_values(by='Difference', ascending=False)\n",
        "\n",
        "# 3 . the genes that increased the most\n",
        "\n",
        "top_3_up = df_sorted.head(10)\n",
        "\n",
        "# 4 . the genes that decreased the most\n",
        "\n",
        "top_3_down = df_sorted.tail(10)\n",
        "\n",
        "# 5 . import all the genes in our table\n",
        "\n",
        "important_genes = pd.concat([top_3_up, top_3_down])\n",
        "\n",
        "# 6 . display all the information we need to know\n",
        "\n",
        "important_genes[['Gene', day0, day7, 'Difference']]"
      ]
